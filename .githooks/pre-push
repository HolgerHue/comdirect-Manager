#!/usr/bin/env bash
# Keel: vor jedem Push nur die Prüfungen, die die Änderung erreicht (scripts/keel-affected-tests).
set -u
root="$(git rev-parse --show-toplevel)"
rc=0
while read -r local_ref local_sha remote_ref remote_sha; do
  case "$local_ref" in refs/tags/*) continue ;; esac
  [ "$local_sha" = 0000000000000000000000000000000000000000 ] && continue
  base="$remote_sha"
  [ "$base" = 0000000000000000000000000000000000000000 ] && base="$(git merge-base "$local_sha" origin/main 2>/dev/null || echo origin/main)"
  echo "keel pre-push: $local_ref (Basis ${base:0:7})"
  ( cd "$root" && scripts/keel-affected-tests --base "$base" --run ) || rc=1
done
[ $rc = 0 ] || echo "Push abgelehnt: ausgewählte Prüfungen rot oder Auswahl fehlgeschlagen."
exit $rc
