#!/usr/bin/env bash
# Keel-Umgebungsprüfung (docs/03-technical-plan.md „Befehle“).
#   scripts/keel-doctor --check
# Zustände: OK, MISSING, N/A. Installiert nichts.
set -u
rc=0
row() { printf '%-10s %-8s %s\n' "$1" "$2" "$3"; if [ "$2" = MISSING ]; then rc=1; fi; return 0; }
if command -v node >/dev/null; then row node OK "$(node --version)"; else row node MISSING "Node.js 18+ für node --check und node --test"; fi
if command -v python3 >/dev/null; then row python3 OK "$(python3 --version 2>&1)"; else row python3 MISSING "Python 3 für die Keel-Skripte"; fi
if command -v git >/dev/null; then row git OK "$(git --version)"; else row git MISSING ""; fi
if [ "$(git -C "$(dirname "$0")/.." config core.hooksPath)" = .githooks ]; then row hooks OK ".githooks"; else row hooks MISSING "git config core.hooksPath .githooks"; fi
row scriptable N/A "läuft nur auf iOS/iPadOS – Echtlauf durch den Nutzer (PLATFORM-IMPOSSIBLE)"
exit $rc
