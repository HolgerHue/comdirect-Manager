#!/usr/bin/env python3
"""Keel-Stop-Hook (project-state.md "scripts/keel-stop-hook"), angepasst an dieses Projekt (D-011).

Läuft am Ende jedes Zuges von Claude Code, sobald er in .claude/settings.json als "Stop"-Hook
angemeldet ist (die Anmeldung macht der Nutzer selbst). Blockiert EINMAL je Befund, wenn
  1a. Arbeit im Repository uncommittet ist,
  1c. docs/continuation-prompt.md nicht mehr HEAD beschreibt,
  1d. der Plan hinter der Arbeit ist (wie scripts/keel-verify).
Nicht gepushte Commits werden nur gemeldet (Push nur auf Anweisung, D-004); Keels Regel 2
"Warteschlange nicht leer" entfällt (Autonomy: not automatic, D-015).
Spin-Schutz: derselbe Befund blockiert nur einmal; höchstens 6 Blockaden je Stunde und Sitzung.
"""

from __future__ import annotations

import hashlib
import json
import os
import subprocess
import sys
import time
from pathlib import Path

PROJECT = Path(__file__).resolve().parent.parent
BOOK = ["docs/sprints", "docs/.keel", "docs/PROGRESS.md", "docs/sessions.md", "docs/token-ledger.md"]


def git(*args: str) -> tuple[int, str]:
    out = subprocess.run(["git", "-C", str(PROJECT), *args], capture_output=True, text=True)
    return out.returncode, out.stdout.rstrip("\n")


def main() -> int:
    try:
        payload = json.load(sys.stdin)
    except (json.JSONDecodeError, ValueError):
        payload = {}
    if payload.get("stop_hook_active"):
        return 0
    session = str(payload.get("session_id") or "unknown")
    findings: list[tuple[str, str, str]] = []  # (Regel, Rohdaten für den Fingerabdruck, Text)

    _, root = git("rev-parse", "--show-toplevel")
    _, dirty = git("status", "--porcelain", "--", root)
    if dirty:
        paths = [line[3:] for line in dirty.splitlines()]
        findings.append(("1a", "\n".join(sorted(dirty.splitlines())),
                         f"Uncommittete Änderungen ({len(paths)}): {', '.join(paths[:6])}"
                         " – mit ausdrücklichen Pfaden committen (vorher Prüfung auf vertrauliche Daten)."))
    handoff = PROJECT / "docs/continuation-prompt.md"
    if handoff.exists():
        head = dict(line.split(": ", 1) for line in handoff.read_text(encoding="utf-8").splitlines()[1:10]
                    if ": " in line)
        _, now = git("rev-parse", "--short", "HEAD")
        if not now.startswith(head.get("Commit", "-")[:7]):
            findings.append(("1c", now, f"Übergabe beschreibt {head.get('Commit')} statt HEAD {now} – "
                                        "neu schreiben (scripts/keel-close)."))
    _, work = git("log", "-1", "--format=%H", "--", ".", *[f":(exclude){b}" for b in BOOK])
    _, plan = git("log", "-1", "--format=%H", "--", "docs/sprints")
    if work and plan and git("merge-base", "--is-ancestor", work, plan)[0] != 0:
        findings.append(("1d", work + plan, "Plan hinter der Arbeit: fertige Scheiben auf done mit actual_hours "
                                            "setzen (scripts/keel-time slice-end) oder fehlende Scheiben anlegen."))

    _, unpushed = git("rev-list", "--count", "@{u}..HEAD")
    note = f" (Hinweis: {unpushed} Commits nicht gepusht – nur auf Anweisung pushen.)" \
        if unpushed not in ("", "0") else ""

    state = Path(os.environ.get("XDG_STATE_HOME", str(Path.home() / ".local/state"))) / "keel"
    state.mkdir(parents=True, exist_ok=True)
    key = hashlib.sha1(f"{PROJECT}|{session}".encode()).hexdigest()[:16]
    log = state / f"stop-blocks-{key}.json"
    seen = json.loads(log.read_text()) if log.exists() else {"blocks": [], "prints": []}
    seen["blocks"] = [t for t in seen["blocks"] if t > time.time() - 3600]
    fresh = []
    for rule, raw, text in findings:
        fp = rule + ":" + hashlib.sha1(raw.encode()).hexdigest()
        if fp not in seen["prints"]:
            fresh.append((fp, f"[{rule}] {text}"))
    if not fresh or len(seen["blocks"]) >= 6:
        if note:
            print(json.dumps({"systemMessage": "keel-stop-hook:" + note}))
        return 0
    seen["prints"] = (seen["prints"] + [fp for fp, _ in fresh])[-50:]
    seen["blocks"].append(time.time())
    log.write_text(json.dumps(seen))
    print(json.dumps({"decision": "block",
                      "reason": "keel-stop-hook: " + " ".join(t for _, t in fresh) + note +
                      " Jeder Befund blockiert nur einmal; ist er gewollt, dem Nutzer den Grund sagen."}))
    return 0


if __name__ == "__main__":
    sys.exit(main())
